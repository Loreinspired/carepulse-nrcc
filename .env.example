# ==============================================================================
# CarePulse — Church Evangelism & Outreach WhatsApp Drip Engine
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=change-me-to-a-long-random-production-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SITE_BASE_URL=http://localhost:8000

# Database (Leave DATABASE_URL empty to use SQLite fallback for local dev/tests)
# Production Postgres example: postgres://carepulse:carepulse_pass@postgres:5432/carepulse
DATABASE_URL=

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Church / Outreach Identity (Ado-Ekiti, Ekiti State, Nigeria)
CHURCH_NAME=New Reality Christian Center
CHURCH_SHORT_NAME=New Reality Christian Center
CHURCH_WHATSAPP_NUMBER=+2348000000000
CHURCH_SUNDAY_TIME=Sundays at 8:00 AM
CHURCH_ADDRESS=Ado-Ekiti, Ekiti State, Nigeria

# ==============================================================================
# Mode A: Meta WhatsApp Cloud API (Set WA_CLOUD_API_ENABLED=False for Mode B Day-1)
# ==============================================================================
WA_CLOUD_API_ENABLED=False
WA_API_VERSION=v22.0
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=carepulse-ado-ekiti-verify-token

# Approved Utility Template for Step 1 outside 24h window ($0.0067/msg)
WA_STEP1_UTILITY_TEMPLATE=outreach_request_confirmation_v1
WA_TEMPLATE_LANGUAGE=en
WA_UTILITY_TEMPLATE_COST_USD=0.0067

# Tier-Aware Rate Limiting (Meta Messaging Tiers: 250 / 1000 / 10000 / 100000)
WA_MESSAGING_TIER_DAILY_LIMIT=250
WA_BATCH_SIZE=50
WA_POLL_INTERVAL_SECONDS=30
WA_MAX_PER_HOUR=250
